# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NOVA BROADCAST (/nova-control) — Server-side environment variables
# Configure BOTH in Cloudflare Pages -> Settings -> Environment Variables (Secrets).
# NEVER expose these in frontend Vite env vars (VITE_*).
NOVA_BROADCAST_ADMIN_CODE="REPLACE_WITH_PERSONAL_ADMIN_LOGIN_CODE"
NOVA_BROADCAST_SESSION_SECRET="REPLACE_WITH_RANDOM_64_CHAR_SESSION_HMAC_KEY"

# Firebase Admin Service Account for FCM HTTP v1 push notifications.
# Option A: Full single-line JSON string of your Firebase Service Account:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}'
# Option B: Individual Service Account fields:
FIREBASE_PROJECT_ID="REPLACE_WITH_FIREBASE_PROJECT_ID"
FIREBASE_CLIENT_EMAIL="REPLACE_WITH_FIREBASE_SERVICE_ACCOUNT_EMAIL"
FIREBASE_PRIVATE_KEY="REPLACE_WITH_FIREBASE_PRIVATE_KEY_PEM"

# Optional shared key checked on X-Nova-App-Key during Android FCM token registration:
# NOVA_ANDROID_REG_KEY=""
